# Database Configuration (Docker & Local)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gestor_finanzas
POSTGRES_PORT=5433

# Backend Connection String
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/gestor_finanzas?schema=public"

# Backend Server
PORT=4001
NODE_ENV=development

# Frontend Server
NEXT_PUBLIC_API_URL=http://localhost:4001

# Supabase Configuration (Frontend - Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Configuration (Backend - NestJS)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-from-dashboard
