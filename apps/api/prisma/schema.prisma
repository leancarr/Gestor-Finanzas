generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model HealthCheck {
  id        String   @id @default(uuid())
  status    String   @default("ok")
  checkedAt DateTime @default(now())
}

model User {
  id         String                 @id @default(uuid())
  email      String                 @unique
  name       String?
  avatarUrl  String?                @map("avatar_url")
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt
  categories Category[]
  expenses   Expense[]
  budgets    Budget[]
  recurring  RecurringTransaction[]
  ownedVaults Vault[]               @relation("OwnedVaults")
  vaultMemberships VaultMember[]
  assets     Asset[]
  challenges Challenge[]
  savingStreak Int                 @default(0) @map("saving_streak")
  lastStreakDate DateTime?         @map("last_streak_date")

  @@map("users")
}

model Category {
  id        String                 @id @default(uuid())
  name      String
  icon      String?
  color     String?
  userId    String                 @map("user_id")
  user      User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  expenses  Expense[]
  budgets   Budget[]
  recurring RecurringTransaction[]
  vaultId   String?                @map("vault_id")
  vault     Vault?                 @relation(fields: [vaultId], references: [id], onDelete: SetNull)

  @@map("categories")
}

enum TransactionType {
  EXPENSE
  INCOME
}

model Expense {
  id           String          @id @default(uuid())
  amount       Decimal         @db.Decimal(12, 2)
  currency     String          @default("ARS")
  type         TransactionType @default(EXPENSE)
  description  String
  date         DateTime        @default(now())
  categoryId   String?         @map("category_id")
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId       String          @map("user_id")
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeRate Decimal?        @map("exchange_rate") @db.Decimal(12, 4)
  isTaxable    Boolean         @default(false) @map("is_taxable")
  vaultId      String?         @map("vault_id")
  vault        Vault?          @relation(fields: [vaultId], references: [id], onDelete: SetNull)
  tags         String[]        @default([])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("expenses")
}

enum VaultRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Vault {
  id          String        @id @default(uuid())
  name        String
  description String?
  ownerId     String        @map("owner_id")
  owner       User          @relation("OwnedVaults", fields: [ownerId], references: [id], onDelete: Cascade)
  members     VaultMember[]
  expenses    Expense[]
  categories  Category[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("vaults")
}

model VaultMember {
  id       String    @id @default(uuid())
  vaultId  String    @map("vault_id")
  vault    Vault     @relation(fields: [vaultId], references: [id], onDelete: Cascade)
  userId   String    @map("user_id")
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     VaultRole @default(MEMBER)
  joinedAt DateTime  @default(now())

  @@unique([vaultId, userId])
  @@map("vault_members")
}

model Budget {
  id         String   @id @default(uuid())
  amount     Decimal  @db.Decimal(12, 2)
  currency   String   @default("ARS")
  month      Int
  year       Int
  categoryId String   @map("category_id")
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, categoryId, month, year])
  @@map("budgets")
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringTransaction {
  id          String              @id @default(uuid())
  name        String
  amount      Decimal             @db.Decimal(12, 2)
  currency    String              @default("ARS")
  type        TransactionType     @default(EXPENSE)
  frequency   RecurrenceFrequency @default(MONTHLY)
  dayOfMonth  Int?                @map("day_of_month")
  nextDueDate DateTime            @map("next_due_date")
  autoDebit   Boolean             @default(true) @map("auto_debit")
  isActive    Boolean             @default(true) @map("is_active")
  categoryId  String?             @map("category_id")
  category    Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@map("recurring_transactions")
}

enum AssetType {
  CASH_ARS
  CASH_USD
  FIXED_TERM
  CEDEAR
  CRYPTO
  OTHER
}

model Asset {
  id            String    @id @default(uuid())
  name          String
  type          AssetType
  ticker        String?
  quantity      Decimal   @db.Decimal(18, 8)
  purchasePrice Decimal?  @map("purchase_price") @db.Decimal(18, 4)
  currentPrice  Decimal?  @map("current_price") @db.Decimal(18, 4)
  currency      String    @default("ARS")
  institution   String?
  dueDate       DateTime? @map("due_date")
  interestRate  Decimal?  @map("interest_rate") @db.Decimal(5, 2)
  notes         String?
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("assets")
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  FAILED
}

model Challenge {
  id               String          @id @default(uuid())
  title            String
  description      String?
  targetDays       Int
  currentStreak    Int             @default(0) @map("current_streak")
  bestStreak       Int             @default(0) @map("best_streak")
  status           ChallengeStatus @default(ACTIVE)
  startDate        DateTime        @default(now()) @map("start_date")
  completedAt      DateTime?       @map("completed_at")
  badgeIcon        String          @default("Shield") @map("badge_icon")
  badgeName        String          @default("Mano de hierro") @map("badge_name")
  targetCategoryId String?         @map("target_category_id")
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("challenges")
}

